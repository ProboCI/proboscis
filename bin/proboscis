#! /usr/bin/env node
'use strict';

const os = require('os');
const parse = require('shell-quote').parse;
const es = require('event-stream');
const Loader = require('yaml-config-loader');

const yargs = require('yargs');
const Proboscis = require('../index');
const server = require('../lib/server');
const runner = new Proboscis();
// The optional config files below may not exist, so keep loading the remaining
// sources (including argv) rather than aborting on the first missing file.
const loader = new Loader({stopOnError: false});

const argv = yargs
  .usage('proboscis -c "echo foo" -c "echo bar"')
  .default('help', false)
  .describe('help', 'Display this help text.')
  .alias('help', 'h')
  .describe('version', 'Print the version number')
  .alias('version', 'v')
  .default('version', false)
  .alias('command', 'c')
  .describe('command', 'A command to run as a child.')
  .describe('name', 'If present, a name for the command in the same position. The first --name will name the first --command.')
  .alias('name', 'n')
  .default('name', false)
  .describe('port', 'If specified, a port to listen on for control commands.')
  .alias('port', 'p')
  // Declared boolean so a bare `--keep-alive` parses as true; with only a
  // default yargs treats the flag as taking a value.
  .boolean('keep-alive')
  .describe('keep-alive', 'Keep the server alive even if all processes have closed, useful if you are going to be restarting services.')
  .alias('keep-alive', 'k')
  .default('keep-alive', false)
  .argv;

if (argv.help) {
  yargs.showHelp();
  process.exit(0);
}

if (argv.version) {
  console.log(require('../package').version);
  process.exit(0);
}

let commands = argv.command;
if (typeof argv.command === 'string') {
  commands = [argv.command];
}

let name = argv.name;
if (typeof argv.name === 'string') {
  name = [argv.name];
}

runner.eventStream
  .pipe(es.stringify())
  .pipe(process.stdout);

for (const i in argv._) {
  loader.add(argv._[i]);
}

if (argv.keepAlive) {
  runner.closeStreamWithLastProcess = false;
}

loader.on('error', function(err) {});
loader.add('/etc/proboscis.yaml');
loader.add(os.homedir() + '/.proboscis.yaml');
loader.add(argv);
loader.load(function(error, config) {
  if (config.port) {
    config.log = console.log;
    server(runner, config);
  }
  for (const i in commands) {
    const command = commands[i];
    const args = parse(command);
    const binary = args.shift();
    let commandName = binary;
    if (name !== false && name[i] !== undefined) {
      commandName = name[i];
    }
    runner.addProcess(commandName, binary, args);
  }
  runner.runConfiguredProcesses();
});
